<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> GR/-\FF </title>
</head>
<body>

    Odaberi drugi graf
    <br>
    <form action="/noviodobir" method="POST" enctype="multipart/form-data" >
        <input class="gumb" type="submit" name="gumb" value="Odaberi drugi graf"> 
    </form>
    <br>

    Odaberi drugi algoritam:
    <br>
    <form action="dijametar" method="GET" enctype="multipart/form-data" >
        <input class="gumb" type="submit" name="gumbDijametar" value="dijametar">
    </form>
    <br>
    <form action="betweennessCentrality" method="GET" enctype="multipart/form-data" >
        <input class="gumb" type="submit" name="gumbBetweennessCentrality" value="betweennessCentrality">
    </form>
    <br>

    Girvan-Newman algoritam

    <br>

    Opis forme

    <br>

    <form id = "parametriForm">
        <label for="brZajednica"> Br. zajednica: </label>
        <select name="brZajednica" id="brZajednica">
            <% for(let i = 1; i <= Object.keys(graf).length; i++) { %>
                <option value="<%= i %>"><%= i %></option>
            <% }; %>
        </select>

        <label for="preskakanje"> Preskakanje: </label>
        <select name="preskakanje" id="preskakanje">
            <% for(let i = 1; i <= Object.keys(graf).length; i++) { %>
                <option value="<%= i %>"><%= i %></option>
            <% }; %>
        </select>

        <button type="submit"> Pokreni </button>
    </form>

    <script src="/scripts/girvanNewman.js"></script>

</body>
</html>