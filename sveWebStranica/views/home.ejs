<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> GR/-\FF </title>

    <link rel="stylesheet" type="text/css"  href="/css/home.css">
    <link rel="stylesheet" type="text/css"  href="/css/header.css">
</head>
<body>
    <% var uneseni = JSON.parse(prikazi) %>
    <%- include('partials/header') %>
    <div class="grid-area-home">

        <% if (graf != undefined) { %>
            <div>
                <B>Trenutno izabrani graf:</B> <%= ime %>
                <hr>
                
                <img src="<%= graf %>" alt="Graf"/>

                <br>
                <br>
            </div>
        <% } %>
        
        <div>
            <B>Upload grafa u txt formatu:</B>
            <hr>
            <div class="forma">
                <form action="/add/txt" method="POST" enctype="multipart/form-data" >
                    <input type="file" name="file" id="file" required>
                    <br>
                    <lable> unesite naziv grafa </lable>
                    <input type="text" name="nazivGrafa" id="nazivGrafa" required>
                    <br>
                    <input class="gumb" type="submit" name="gumb" value="Podnesi"> 
                </form>
            </div>
            <br>
            <br>
        </div>
        
        <div>
            <B>Upload grafa u json formatu:</B>
            <hr>
            <div class="forma1">
                <form action="/add/json" method="POST" enctype="multipart/form-data" >
                    <input type="file" name="file" id="file" required>
                    <br>
                    <lable> unesite naziv grafa </lable>
                    <input type="text" name="nazivGrafa" id="nazivGrafa" required>
                    <br>
                    <input class="gumb" type="submit" name="gumb" value="Podnesi"> 
                </form>
            </div>
            <br>
            <br>
        </div>

        <div>
            <B>Odabir grafa već unesenog u bazu:</B>
            <hr>
            <% uneseni.forEach(element => { %>
                <div class="forma2">
                    <B>Ime grafa: </B> <%= element.ime %>
                    <br>

                    <B>JSON zapis : </B>
                    <% Object.keys(element.data).forEach(key => { %>
                        <%= key %> : <%= JSON.stringify(element.data[key]) %>, 
                    <% }) %>
                    <br>

                    <B>Stvoren: </B> <%= element.stvoren %>
                    <br>

                    <form action="/stariodobir" method="POST" enctype="multipart/form-data" >
                        <input type="hidden" name="grafid" value=<%= element.id %>>
                        <input type="submit" name="gumb" value="Odaberi graf"> 
                    </form>
                </div>
                <br>
            <% }) %>
        </div>
    </div>

    

    

    <%- include('partials/footer') %>
</body>
</html>